#ifndef SETTINGS_H
#define SETTINGS_H

// Copy this file to settings.h and adjust TABLE_NUMBER before flashing each
// watch. settings.h is gitignored so two watches never accidentally get
// flashed with the same table number from a stale local copy.

// ---------------------------------------------------------------
// Hardware revision: 2 = ESP32-PICO-D4 (v1 / v1.5 / v2, micro-USB)
//                     3 = ESP32-S3 (v3, USB-C)
// Must match HSCR_PinTest.ino's WATCHY_HW for whatever board you flash.
// ---------------------------------------------------------------
#define WATCHY_HW 2

// ---------------------------------------------------------------
// This watch's table number. Used to name its broadcast network
// (so two watches don't collide) and as the default pre-filled table
// number on the order page — the guest can still type a different one.
// ---------------------------------------------------------------
#define TABLE_NUMBER 1

// ---------------------------------------------------------------
// The watch broadcasts its own WiFi network — no venue WiFi/internet
// needed at all. Guests join this network directly, then a page opens
// (or they browse to 192.168.4.1) to place a request.
// AP_PASSWORD "" = open network (easiest for guests). Set 8+ characters
// to require a password instead.
// ---------------------------------------------------------------
#define AP_SSID_PREFIX  "HSCR-Table-"
#define AP_PASSWORD     ""

// ---------------------------------------------------------------
// Vibration pattern while a request is waiting to be acknowledged:
// buzz for VIBRATE_ON_MS, pause for VIBRATE_OFF_MS, repeat — until
// MENU is pressed.
// ---------------------------------------------------------------
#define VIBRATE_ON_MS   400UL
#define VIBRATE_OFF_MS  1600UL

#endif
